(version 1)
(rule "PTH ring" (condition "A.Pad_Type == 'Through-hole'") (constraint annular_width (min 0.18mm)))
(rule "Component holes" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "No via drill in SMD lands" (condition "A.Type == 'Via' && B.Pad_Type == 'SMD'") (constraint physical_hole_clearance (min 0.15mm)))
(rule "Default width" (condition "A.hasNetclass('Default')") (constraint track_width (min 0.15mm) (opt 0.15mm)))
(rule "USB_Pair width" (condition "A.hasNetclass('USB_Pair')") (constraint track_width (min 0.25mm) (opt 0.25mm)))
(rule "Data_Control width" (condition "A.hasNetclass('Data_Control')") (constraint track_width (min 0.15mm) (opt 0.15mm)))
(rule "QSPI width" (condition "A.hasNetclass('QSPI')") (constraint track_width (min 0.15mm) (opt 0.15mm)))
(rule "Clock width" (condition "A.hasNetclass('Clock')") (constraint track_width (min 0.2mm) (opt 0.2mm)))
(rule "Clock_Source width" (condition "A.hasNetclass('Clock_Source')") (constraint track_width (min 0.15mm) (opt 0.15mm)))
(rule "Crystal width" (condition "A.hasNetclass('Crystal')") (constraint track_width (min 0.15mm) (opt 0.15mm)))
(rule "CV_Analog width" (condition "A.hasNetclass('CV_Analog')") (constraint track_width (min 0.25mm) (opt 0.25mm)))
(rule "Audio width" (condition "A.hasNetclass('Audio')") (constraint track_width (min 0.25mm) (opt 0.25mm)))
(rule "Line_Output width" (condition "A.hasNetclass('Line_Output')") (constraint track_width (min 0.3mm) (opt 0.3mm)))
(rule "MIDI_Isolated width" (condition "A.hasNetclass('MIDI_Isolated')") (constraint track_width (min 0.25mm) (opt 0.25mm)))
(rule "Gate width" (condition "A.hasNetclass('Gate')") (constraint track_width (min 0.2mm) (opt 0.2mm)))
(rule "Logic_Power width" (condition "A.hasNetclass('Logic_Power')") (constraint track_width (min 0.45mm) (opt 0.45mm)))
(rule "Core_Power width" (condition "A.hasNetclass('Core_Power')") (constraint track_width (min 0.35mm) (opt 0.35mm)))
(rule "Sound_Power width" (condition "A.hasNetclass('Sound_Power')") (constraint track_width (min 0.75mm) (opt 0.75mm)))
(rule "Analog_Power width" (condition "A.hasNetclass('Analog_Power')") (constraint track_width (min 0.5mm) (opt 0.5mm)))
(rule "USB_Power width" (condition "A.hasNetclass('USB_Power')") (constraint track_width (min 1.0mm) (opt 1.0mm)))
(rule "Boost_Switch width" (condition "A.hasNetclass('Boost_Switch')") (constraint track_width (min 0.75mm) (opt 0.75mm)))
(rule "Ground width" (condition "A.hasNetclass('Ground')") (constraint track_width (min 0.25mm) (opt 0.5mm)))
(rule "Converter VIN bias branch" (condition "A.NetName == 'USB_VBUS' && A.intersectsArea('BOOST_VIN_BRANCH')") (constraint track_width (min 0.25mm)))
(rule "Small power IC lead escapes" (condition "A.Type == 'Track' && (A.hasNetclass('USB_Power') || A.hasNetclass('Logic_Power') || A.hasNetclass('Ground')) && (A.intersectsCourtyard('U5') || A.intersectsCourtyard('U9'))") (constraint track_width (min 0.25mm)))
(rule "Fine-pitch IC escapes" (condition "A.Type == 'Track' && (A.intersectsCourtyard('U1') || A.intersectsCourtyard('U3') || A.intersectsCourtyard('U14') || A.intersectsCourtyard('U15') || A.intersectsCourtyard('U16'))") (constraint track_width (min 0.15mm)))
(rule "USB connector escapes" (condition "A.Type == 'Track' && A.intersectsCourtyard('J1')") (constraint track_width (min 0.15mm)))
