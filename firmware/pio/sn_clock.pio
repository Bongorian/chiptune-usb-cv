; Variable SN clock. At 128MHz, each half-wave is X+5 cycles.
; X=0..UINT32_MAX, divider=1..65536 (16.8 fixed point), steady 50% duty.
; Empty FIFO recycles X. Host reconfiguration restarts at low; transient phase is not measured.
.program sn_clock
.wrap_target
    pull noblock
    mov x, osr
    set pins, 1
    mov y, x
high:
    jmp y-- high
    nop [1]
    set pins, 0
    mov y, x
low:
    jmp y-- low
.wrap
